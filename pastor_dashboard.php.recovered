                                                if (isset($available_categorized[$dept][$expected_role])) {
                                                    $val = htmlspecialchars($available_categorized[$dept][$expected_role]);
                                                    echo "<option value=\"$val\">$val</option>";
                                                }
                                            }
                                            echo "</optgroup>";
                                        }
                                    }

                                    if (!empty($available_uncategorized)) {
                                        echo "<optgroup label=\"Other Roles\">";
                                        foreach ($available_uncategorized as $val) {
                                            $val_clean = htmlspecialchars($val);
                                            echo "<option value=\"$val_clean\">$val_clean</option>";
