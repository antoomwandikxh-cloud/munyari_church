                <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                    <!-- Assign Role Form -->
                    <div class="content-card" style="flex: 1; min-width: 300px;">
                        <h2>Assign to Member</h2>
                        <form method="POST" action="pastor_action.php?action=assign_role">
                            <div class="form-group">
                                <label>Select Member</label>
                                <select name="member_id" class="form-control" required>
                                    <option value="">-- Select Member --</option>
                                    <?php 
                                    $approved_members->data_seek(0);
                                    while($m = $approved_members->fetch_assoc()): ?>
                                        <option value="<?= $m['id'] ?>"><?= htmlspecialchars($m['first_name'] . ' ' . $m['last_name']) ?> (Current: <?= htmlspecialchars($m['church_role'] ?? 'Member') ?>)</option>
                                    <?php endwhile; ?>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Assign Role</label>
                                <select name="role" class="form-control" required>
                                    <option value="">-- Select Role --</option>
                                    <?php 
                                    // Organize available roles into hierarchy
                                    $available_categorized = [];
                                    $available_uncategorized = [];
                                    while($r = $church_roles->fetch_assoc()) {
                                        $r_name = trim($r['role_name']);
                                        $placed = false;
                                        foreach($hierarchy as $dept => $roles) {
                                            foreach($roles as $expected_role) {
                                                if (strtolower($r_name) === strtolower($expected_role)) {
                                                    $available_categorized[$dept][$expected_role] = $r_name;
                                                    $placed = true;
                                                    break 2;
                                                }
                                            }
                                        }
                                        if (!$placed) {
                                            $available_uncategorized[] = $r_name;
                                        }
                                    }

                                    foreach ($hierarchy as $dept => $roles) {
                                        if (!empty($available_categorized[$dept])) {
                                            echo "<optgroup label=\"$dept\">";
